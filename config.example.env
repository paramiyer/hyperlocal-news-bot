# ── hyperlocal-news-bot config ── copy to config.env and fill in ──────────────
# Where you cloned this repo (absolute path):
BOT_DIR="/Users/you/hyperlocal-news-bot"

# WhatsApp bridge (from the whatsapp-mcp install — see README):
WA_BRIDGE_URL="http://localhost:8080/api/send"

# Destination WhatsApp GROUP JID (get it from the bridge store — see README):
GROUP_JID="0000000000-0000000000@g.us"
GROUP_NAME="My Neighbourhood Group"

# Your own number for failure alerts (country code, no +, then @s.whatsapp.net):
ALERT_JID="910000000000@s.whatsapp.net"

# Your locality centre (decimal lat/lon) and radius:
ORIGIN_NAME="My Area"
ORIGIN_LAT="19.0790"   # example: Garodia Nagar — REPLACE with your area
ORIGIN_LON="72.9080"   # example — REPLACE
RADIUS_KM="6"

# Timezone + when to send (24h local host time = your target IST time minus offset):
SEND_HOUR_HOST="5"     # host-local hour the send should fire at
SEND_MIN_HOST="30"
